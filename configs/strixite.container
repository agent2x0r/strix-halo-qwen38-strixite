[Unit]
Description=Strixite Qwen3.8-Flash-Next inference server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=strixite
Image=ghcr.io/shawnshekari/strixite:v0.7.1
Network=host
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
SecurityLabelDisable=true
SeccompProfile=unconfined
Volume=/mnt/models/strix-infer:/models
Exec=--prompt-cache-ram-margin-gib 5 --prompt-cache-disk-free-gib 16 --prompt-cache-gib 72

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
